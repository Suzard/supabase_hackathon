# Copy to .env.local and fill in. Never commit .env.local.

# Vercel AI Gateway key. Used ONLY for Jev routing decisions
# (POST https://ai-gateway.vercel.sh/typesafe/v1/systemone). Donated keys never touch the Gateway.
AI_GATEWAY_API_KEY=

# Supabase project (server-side only; the service role key bypasses RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes, base64. Encrypts donated provider keys at rest.
# Generate with: openssl rand -base64 32
POOL_ENCRYPTION_KEY=

# Seed keys, donated through the real /donate flow by `pnpm seed`. Two Anthropic keys
# are needed for the demo: with one, there is no routing decision for Jev to make.
SEED_OPENAI_KEY=
SEED_ANTHROPIC_KEY=
SEED_ANTHROPIC_KEY_2=
